# AI Radar - Environment Variables
# Copy this file to .env and fill in your values

# LLM API Keys (at least one recommended, but not required)
# Without API keys, mock signal generation will be used
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Override default model names
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini

# Frontend API URL (for production deployment)
# NEXT_PUBLIC_API_URL=https://your-backend-url.com
